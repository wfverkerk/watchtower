<mxfile host="app.diagrams.net"><diagram id="app-flow" name="App-flow"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2300" pageHeight="2300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c101" value="Watchtower – app-flow (Vue 3 + Supabase)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1200" height="30" as="geometry"/></mxCell><mxCell id="c102" value="Containers = pagina's/dialogen. Gele blokken = voorwaarden (v-if), rood = fouten/meldingen, paars = dialogen, blauwe ronde knoppen = acties. Pijlen met label = navigatie + voorwaarde." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="32" width="1300" height="30" as="geometry"/></mxCell><mxCell id="c103" value="Topbar en meldingen (altijd zichtbaar)" style="swimlane;whiteSpace=wrap;html=1;startSize=28;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="380" height="397" as="geometry"/></mxCell><mxCell id="c104" value="Merk-link → sluit live-weergave, opent Wedstrijdenoverzicht (homeOpen = true)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c103"><mxGeometry x="10" y="36" width="360" height="44" as="geometry"/></mxCell><mxCell id="c105" value="Statistiekenknop → Statistiekenpagina" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c103"><mxGeometry x="10" y="88" width="360" height="29" as="geometry"/></mxCell><mxCell id="c106" value="Sync-indicator (offline/syncing/synced) + deelknop&lt;br&gt;alleen als !teamSetupOpen &amp;amp;&amp;amp; !homeOpen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c103"><mxGeometry x="10" y="125" width="360" height="59" as="geometry"/></mxCell><mxCell id="c107" value="Avatar → profiel bewerken" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c103"><mxGeometry x="10" y="192" width="360" height="29" as="geometry"/></mxCell><mxCell id="c108" value="Meldingen (elk conditioneel): storageError, pageError, sharedInitialError, authCallbackBlocked, matchSyncError (alleen zonder matchLink), offlineSetupError, wakelock niet ondersteund/fout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c103"><mxGeometry x="10" y="229" width="360" height="89" as="geometry"/></mxCell><mxCell id="c109" value="updateAvailable → knop 'nu bijwerken'&lt;br&gt;als updateBlocked (gameStarted &amp;amp;&amp;amp; klok loopt) → tekst 'na de wedstrijd'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c103"><mxGeometry x="10" y="326" width="360" height="59" as="geometry"/></mxCell><mxCell id="c110" value="App.vue – routering (eerste passende voorwaarde wint)" style="swimlane;whiteSpace=wrap;html=1;startSize=28;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="557" width="380" height="664" as="geometry"/></mxCell><mxCell id="c111" value="0. START: profiel in localStorage? Nee → userProfileOpen = true (onboarding). Ja → homeOpen = true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c110"><mxGeometry x="10" y="36" width="360" height="59" as="geometry"/></mxCell><mxCell id="c112" value="1. userProfileOpen (overlay, v-if)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c110"><mxGeometry x="10" y="103" width="360" height="29" as="geometry"/></mxCell><mxCell id="c113" value="2. coachLoginOpen (overlay, v-if)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c110"><mxGeometry x="10" y="140" width="360" height="29" as="geometry"/></mxCell><mxCell id="c114" value="3. statisticsOpen &amp;amp;&amp;amp; !userProfileOpen &amp;amp;&amp;amp; !coachLoginOpen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c110"><mxGeometry x="10" y="177" width="360" height="44" as="geometry"/></mxCell><mxCell id="c115" value="4. liveView &amp;amp;&amp;amp; !userProfileOpen &amp;amp;&amp;amp; !coachLoginOpen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c110"><mxGeometry x="10" y="229" width="360" height="44" as="geometry"/></mxCell><mxCell id="c116" value="5. homeOpen &amp;amp;&amp;amp; userProfile &amp;amp;&amp;amp; !userProfileOpen &amp;amp;&amp;amp; !coachLoginOpen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c110"><mxGeometry x="10" y="281" width="360" height="44" as="geometry"/></mxCell><mxCell id="c117" value="6. userProfile &amp;amp;&amp;amp; teamSetupOpen &amp;amp;&amp;amp; !teamSetupInitializing &amp;amp;&amp;amp; !statisticsOpen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c110"><mxGeometry x="10" y="333" width="360" height="44" as="geometry"/></mxCell><mxCell id="c118" value="7. teamSetupInitializing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c110"><mxGeometry x="10" y="385" width="360" height="29" as="geometry"/></mxCell><mxCell id="c119" value="8. rosterEditing &amp;amp;&amp;amp; rosterEditProfile &amp;amp;&amp;amp; !userProfileOpen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c110"><mxGeometry x="10" y="422" width="360" height="44" as="geometry"/></mxCell><mxCell id="c120" value="9. anders: !userProfileOpen &amp;amp;&amp;amp; !statisticsOpen → hoofdscherm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c110"><mxGeometry x="10" y="474" width="360" height="44" as="geometry"/></mxCell><mxCell id="c121" value="Overlay: matchSyncOpen &amp;amp;&amp;amp; !userProfileOpen &amp;amp;&amp;amp; !coachLoginOpen → Match-sync dialoog" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c110"><mxGeometry x="10" y="526" width="360" height="44" as="geometry"/></mxCell><mxCell id="c122" value="Voettekst: knop 'spelers bewerken' als gameStarted &amp;amp;&amp;amp; !teamSetupOpen &amp;amp;&amp;amp; !userProfileOpen &amp;amp;&amp;amp; !rosterEditing &amp;amp;&amp;amp; !statisticsOpen (disabled zonder rosterEditProfile)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c110"><mxGeometry x="10" y="578" width="360" height="74" as="geometry"/></mxCell><mxCell id="c123" value="Pagina: Profiel / onboarding (UserProfileDialog)" style="swimlane;whiteSpace=wrap;html=1;startSize=28;rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="640" y="120" width="380" height="486" as="geometry"/></mxCell><mxCell id="c124" value="ZICHTBAAR ALS: userProfileOpen (geen profiel = onboarding, of bewerken via avatar/coach-flow)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c123"><mxGeometry x="10" y="36" width="360" height="59" as="geometry"/></mxCell><mxCell id="c125" value="Naam (verplicht)  ·  beschrijving (optioneel)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c123"><mxGeometry x="10" y="103" width="360" height="29" as="geometry"/></mxCell><mxCell id="c126" value="Taal: NL / EN / CS  ·  thema: licht / donker (live voorbeeld)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c123"><mxGeometry x="10" y="140" width="360" height="44" as="geometry"/></mxCell><mxCell id="c127" value="Installatienotitie" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c123"><mxGeometry x="10" y="192" width="360" height="29" as="geometry"/></mxCell><mxCell id="c128" value="Alleen bij bewerken (profiel bestaat):&lt;br&gt;• scherm-aan checkbox (wakelock)&lt;br&gt;• knop coach-login&lt;br&gt;• reset-knop&lt;br&gt;• buildcode" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c123"><mxGeometry x="10" y="229" width="360" height="89" as="geometry"/></mxCell><mxCell id="c129" value="Annuleren (alleen als profiel bestaat) → herstelt taal en thema, sluit dialoog" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c123"><mxGeometry x="10" y="326" width="360" height="44" as="geometry"/></mxCell><mxCell id="c130" value="Opslaan / Doorgaan (disabled zonder naam) → profiel opslaan, dialoog sluit" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c123"><mxGeometry x="10" y="378" width="360" height="44" as="geometry"/></mxCell><mxCell id="c131" value="Opslaan mislukt → foutmelding errors.saveUserProfile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c123"><mxGeometry x="10" y="430" width="360" height="44" as="geometry"/></mxCell><mxCell id="c132" value="Dialoog: Coach-login (CoachLoginDialog)" style="swimlane;whiteSpace=wrap;html=1;startSize=28;rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="640" y="646" width="380" height="255" as="geometry"/></mxCell><mxCell id="c133" value="ZICHTBAAR ALS: coachLoginOpen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c132"><mxGeometry x="10" y="36" width="360" height="29" as="geometry"/></mxCell><mxCell id="c134" value="Niet aangemeld → e-mailveld + 'stuur magic link'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c132"><mxGeometry x="10" y="73" width="360" height="44" as="geometry"/></mxCell><mxCell id="c135" value="Aangemeld → toont e-mail + knop afmelden" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c132"><mxGeometry x="10" y="125" width="360" height="29" as="geometry"/></mxCell><mxCell id="c136" value="hasMatch + releaseMatch → knop om afgeronde wedstrijd los te koppelen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c132"><mxGeometry x="10" y="162" width="360" height="44" as="geometry"/></mxCell><mxCell id="c137" value="Sluiten → coachLoginOpen = false" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c132"><mxGeometry x="10" y="214" width="360" height="29" as="geometry"/></mxCell><mxCell id="c138" value="Pagina: Wedstrijdenoverzicht (UpcomingGamesPage)" style="swimlane;whiteSpace=wrap;html=1;startSize=28;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1240" y="120" width="380" height="836" as="geometry"/></mxCell><mxCell id="c139" value="ZICHTBAAR ALS: homeOpen &amp;amp;&amp;amp; userProfile &amp;amp;&amp;amp; !userProfileOpen &amp;amp;&amp;amp; !coachLoginOpen (en niet statisticsOpen / liveView: die staan eerder in de keten)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c138"><mxGeometry x="10" y="36" width="360" height="74" as="geometry"/></mxCell><mxCell id="c140" value="!configured → melding 'Supabase niet geconfigureerd'; laadfout; lokale laadfout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c138"><mxGeometry x="10" y="118" width="360" height="44" as="geometry"/></mxCell><mxCell id="c141" value="Huidige wedstrijd (alleen als hasCurrentGame)&lt;br&gt;hasCurrentGame = matchLink ? !finished : !localFinishedAt &amp;amp;&amp;amp; (period gezet || acties &amp;gt; 0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c138"><mxGeometry x="10" y="170" width="360" height="59" as="geometry"/></mxCell><mxCell id="c142" value="Knop 'verder' → homeOpen = false (naar hoofdscherm)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c138"><mxGeometry x="10" y="237" width="360" height="44" as="geometry"/></mxCell><mxCell id="c143" value="Gestarte sessies: lege tekst als er geen zijn. Per sessie: teams + starttijd, 'opnemen voor' thuis/uit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c138"><mxGeometry x="10" y="289" width="360" height="59" as="geometry"/></mxCell><mxCell id="c144" value="sessionPhase: upcoming (&amp;gt;10 min vóór start) / open (−10 t/m +180 min) / closed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c138"><mxGeometry x="10" y="356" width="360" height="44" as="geometry"/></mxCell><mxCell id="c145" value="Volgen (alleen phase = open) → joinSession(followOnly)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c138"><mxGeometry x="10" y="408" width="360" height="44" as="geometry"/></mxCell><mxCell id="c146" value="Registreren (alleen !hasCurrentGame &amp;amp;&amp;amp; open) → joinSession(thuis/uit)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c138"><mxGeometry x="10" y="460" width="360" height="44" as="geometry"/></mxCell><mxCell id="c147" value="Sluiten (alleen canClose) → sessie sluiten" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c138"><mxGeometry x="10" y="512" width="360" height="29" as="geometry"/></mxCell><mxCell id="c148" value="Lokaal afgeronde wedstrijden (alleen localMatches.length &amp;gt; 0):&lt;br&gt;doel = nieuwe sessie of passende sessie (zelfde start en teamnamen)&lt;br&gt;indienen vereist configured &amp;amp;&amp;amp; matchInfo.startsAt &amp;amp;&amp;amp; geen lopende inzending&lt;br&gt;reeds ingediend → label 'ingediend'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c138"><mxGeometry x="10" y="549" width="360" height="119" as="geometry"/></mxCell><mxCell id="c149" value="Nieuwe online wedstrijd (alleen !hasCurrentGame &amp;amp;&amp;amp; configured) → startNewGame(true)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c138"><mxGeometry x="10" y="676" width="360" height="44" as="geometry"/></mxCell><mxCell id="c150" value="Nieuwe lokale wedstrijd (alleen !hasCurrentGame) → startNewGame(false)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c138"><mxGeometry x="10" y="728" width="360" height="44" as="geometry"/></mxCell><mxCell id="c151" value="Ververst elke 30 s, klok tikt elke 10 s, en bij het 'online'-event" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c138"><mxGeometry x="10" y="780" width="360" height="44" as="geometry"/></mxCell><mxCell id="c152" value="Pagina: Wizard nieuwe wedstrijd (TeamSetupDialog, 3 stappen)" style="swimlane;whiteSpace=wrap;html=1;startSize=28;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1840" y="120" width="380" height="976" as="geometry"/></mxCell><mxCell id="c153" value="ZICHTBAAR ALS: userProfile &amp;amp;&amp;amp; teamSetupOpen &amp;amp;&amp;amp; !teamSetupInitializing &amp;amp;&amp;amp; !statisticsOpen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c152"><mxGeometry x="10" y="36" width="360" height="44" as="geometry"/></mxCell><mxCell id="c154" value="Stappenbalk: Team → Spelers → Tegenstander. Terug naar eerdere stap altijd; vooruit alleen als canAdvance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c152"><mxGeometry x="10" y="88" width="360" height="59" as="geometry"/></mxCell><mxCell id="c155" value="STAP 1 – Team" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c152"><mxGeometry x="10" y="155" width="360" height="29" as="geometry"/></mxCell><mxCell id="c156" value="Teamknoppen uit Zoebas-catalogus (met logo's via TeamLogo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c152"><mxGeometry x="10" y="192" width="360" height="44" as="geometry"/></mxCell><mxCell id="c157" value="Lokaal team toevoegen (localOnly = !newOnlineSession)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c152"><mxGeometry x="10" y="244" width="360" height="44" as="geometry"/></mxCell><mxCell id="c158" value="Foutmeldingen; 'gecachete teams'; laadindicator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c152"><mxGeometry x="10" y="296" width="360" height="44" as="geometry"/></mxCell><mxCell id="c159" value="STAP 2 – Spelers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c152"><mxGeometry x="10" y="348" width="360" height="29" as="geometry"/></mxCell><mxCell id="c160" value="RosterEditor: nummer, naam, aanwezig ja/nee, speler toevoegen, coaches met rol, deelnameteller" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c152"><mxGeometry x="10" y="385" width="360" height="59" as="geometry"/></mxCell><mxCell id="c161" value="Knop 'gedeelde roster gebruiken' (alleen als gedeelde roster beschikbaar)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c152"><mxGeometry x="10" y="452" width="360" height="44" as="geometry"/></mxCell><mxCell id="c162" value="&amp;lt; 2 deelnemende spelers → foutmelding; Volgende disabled" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c152"><mxGeometry x="10" y="504" width="360" height="44" as="geometry"/></mxCell><mxCell id="c163" value="STAP 3 – Tegenstander" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c152"><mxGeometry x="10" y="556" width="360" height="29" as="geometry"/></mxCell><mxCell id="c164" value="OpponentTeamInput: combobox met autosuggest uit opponent_teams + logo's" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c152"><mxGeometry x="10" y="593" width="360" height="44" as="geometry"/></mxCell><mxCell id="c165" value="Starttijd-veld verschijnt zodra er een tegenstandernaam is" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c152"><mxGeometry x="10" y="645" width="360" height="44" as="geometry"/></mxCell><mxCell id="c166" value="Programma + uitslagen; afgelaste wedstrijden disabled; badge 'aanbevolen'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c152"><mxGeometry x="10" y="697" width="360" height="44" as="geometry"/></mxCell><mxCell id="c167" value="Geen wedstrijd gekozen → 'kies een wedstrijd'; canAdvance = hasMatchSelection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c152"><mxGeometry x="10" y="749" width="360" height="44" as="geometry"/></mxCell><mxCell id="c168" value="Footer: Terug (stap &amp;gt; 0) · Volgende (canAdvance) · 'Opslaan en doorgaan' (laatste stap)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c152"><mxGeometry x="10" y="801" width="360" height="44" as="geometry"/></mxCell><mxCell id="c169" value="Annuleren alleen als canCancelTeamSetup (period gezet || gameStarted || acties &amp;gt; 0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c152"><mxGeometry x="10" y="853" width="360" height="44" as="geometry"/></mxCell><mxCell id="c170" value="Na opslaan: applyTeamSetup. Bij newOnlineSession ook createSharedMatch (mislukt → pageError). teamSetupOpen = false" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c152"><mxGeometry x="10" y="905" width="360" height="59" as="geometry"/></mxCell><mxCell id="c171" value="Laadscherm (teamSetupInitializing)" style="swimlane;whiteSpace=wrap;html=1;startSize=28;rounded=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1840" y="1136" width="380" height="129" as="geometry"/></mxCell><mxCell id="c172" value="ZICHTBAAR ALS: teamSetupInitializing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="c171"><mxGeometry x="10" y="36" width="360" height="29" as="geometry"/></mxCell><mxCell id="c173" value="Spinner/placeholder zolang teamSetupInitializing; daarna wizard of hoofdscherm" style="rounded=1;